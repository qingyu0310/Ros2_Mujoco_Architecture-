          vertex="0.018000 0.014000 0.000000 0.018000 0.013523 0.003623 0.018000 0.012124 0.007000 0.018000 0.009899 0.009899 0.018000 0.007000 0.012124 0.018000 0.003623 0.013523 0.018000 0.000000 0.014000 0.018000 -0.003623 0.013523 0.018000 -0.007000 0.012124 0.018000 -0.009899 0.009899 0.018000 -0.012124 0.007000 0.018000 -0.013523 0.003623 0.018000 -0.014000 0.000000 0.018000 -0.013523 -0.003623 0.018000 -0.012124 -0.007000 0.018000 -0.009899 -0.009899 0.018000 -0.007000 -0.012124 0.018000 -0.003623 -0.013523 0.018000 -0.000000 -0.014000 0.018000 0.003623 -0.013523 0.018000 0.007000 -0.012124 0.018000 0.009899 -0.009899 0.018000 0.012124 -0.007000 0.018000 0.013523 -0.003623 0.018000 0.008500 0.000000 0.018000 0.008210 0.002200 0.018000 0.007361 0.004250 0.018000 0.006010 0.006010 0.018000 0.004250 0.007361 0.018000 0.002200 0.008210 0.018000 0.000000 0.008500 0.018000 -0.002200 0.008210 0.018000 -0.004250 0.007361 0.018000 -0.006010 0.006010 0.018000 -0.007361 0.004250 0.018000 -0.008210 0.002200 0.018000 -0.008500 0.000000 0.018000 -0.008210 -0.002200 0.018000 -0.007361 -0.004250 0.018000 -0.006010 -0.006010 0.018000 -0.004250 -0.007361 0.018000 -0.002200 -0.008210 0.018000 -0.000000 -0.008500 0.018000 0.002200 -0.008210 0.018000 0.004250 -0.007361 0.018000 0.006010 -0.006010 0.018000 0.007361 -0.004250 0.018000 0.008210 -0.002200 0.109000 0.014000 0.000000 0.109000 0.013523 0.003623 0.109000 0.012124 0.007000 0.109000 0.009899 0.009899 0.109000 0.007000 0.012124 0.109000 0.003623 0.013523 0.109000 0.000000 0.014000 0.109000 -0.003623 0.013523 0.109000 -0.007000 0.012124 0.109000 -0.009899 0.009899 0.109000 -0.012124 0.007000 0.109000 -0.013523 0.003623 0.109000 -0.014000 0.000000 0.109000 -0.013523 -0.003623 0.109000 -0.012124 -0.007000 0.109000 -0.009899 -0.009899 0.109000 -0.007000 -0.012124 0.109000 -0.003623 -0.013523 0.109000 -0.000000 -0.014000 0.109000 0.003623 -0.013523 0.109000 0.007000 -0.012124 0.109000 0.009899 -0.009899 0.109000 0.012124 -0.0070