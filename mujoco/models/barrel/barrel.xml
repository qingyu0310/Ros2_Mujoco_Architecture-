<?xml version="1.0"?>
<!-- 中空枪管原型。
     pitch 层通过 attach 把 barrel_link 挂到 pitch_link 上。

     设计约束：
       子弹：17 mm 小弹丸，黄绿色球，质量 3.2 g，直径 16.8 mm。
       枪管内径 17 mm，外径约 28 mm，后续可在中空通道内生成弹丸并沿 +X 发射。
       摩擦轮嵌入枪管根部左右两侧，轮面伸入内孔，靠软接触夹住弹丸。 -->
<mujoco model="barrel_unit">
  <compiler angle="degree" autolimits="true"/>

  <asset>
    <!-- 中空圆柱枪管 mesh：轴线沿局部 X，内半径 0.0085 m（直径 17 mm），外半径 0.014 m。
         后端 x=0.018 m，前端 x=0.109 m，是上一版 0.182 m 长度的一半。 -->
