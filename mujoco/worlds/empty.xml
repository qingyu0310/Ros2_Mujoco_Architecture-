<?xml version="1.0"?>
<!-- 小车越野测试场：X 向前、Y 向左、Z 向上，所有尺寸单位为 m。
     原点半径 0.8 m 内保留平地；地形为固定碰撞体，不含机器人。
     中路 y=0：连续上下坡；左路 y=2：阶梯；右路 y=-2：交错凸块。
     后方 y=-4：横向路障和窄桥。机器人仍由仿真节点单独加载。 -->
<mujoco model="empty">

  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81" iterations="100"/>

  <!-- 全场打亮：headlight 是跟着相机走的头灯，把它的 ambient/diffuse 拉高，
       任何角度、任何面都不会落进死黑里；场景里那盏平行光只作方向补光。
       MuJoCo 的 headlight 默认 ambient 0.1 / diffuse 0.4，偏暗。 -->
  <visual>
    <headlight ambient="0.6 0.6 0.6" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture name="terrain_grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.32 0.36 0.32" rgb2="0.40 0.44 0.40"/>
    <material name="terrain_ground" texture="terrain_grid" texrepeat="24 24" texuniform="true"/>
    <!-- 封闭三棱柱：底面 z=0，坡顶从 x=0 的 0 上升至 x=1 的 1；各实例用 scale 定尺寸，三角形按外法线逆时针排列。 -->
    <mesh name="ramp_gentle" scale="1.5 1.0 0.20"
          vertex="0 -0.5 0  1 -0.5 0  1 -0.5 1  0 0.5 0  1 0.5 0  1 0.5 1"
          face="0 1 2  3 5 4  0 4 1  0 3 4  1 5 2  1 4 5  0 5 3  0 2 5"/>
    <mesh name="ramp_steep" scale="1.0 1.0 0.30"
          vertex="0 -0.5 0  1 -0.5 0  1 -0.5 1  0 0.5 0  1 0.5 0  1 0.5 1"
          face="0 1 2  3 5 4  0 4 1  0 3 4  1 5 2  1 4 5  0 5 3  0 2 5"/>
  </asset>

  <default>
    <default class="terrain">
      <geom friction="1.0 0.02 0.001" rgba="0.58 0.52 0.40 1"/>
    </default>
    <default class="box">
      <geom type="box" density="500" rgba="0.65 0.65 0.65 1"/>
    </default>
    <default class="cylinder">
      <geom type="cylinder" density="500" rgba="0.45 0.50 0.55 1"/>
    </default>
    <default class="sphere">
      <geom type="sphere" density="500" rgba="0.75 0.55 0.35 1"/>
    </default>
    <default class="hinge">
      <joint type="hinge" damping="0.02" armature="0.001"/>
    </default>
  </default>

  <worldbody>
    <light name="sun" pos="0 -3 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="ground" type="plane" size="8 6 0.05" material="terrain_ground" friction="1.0 0.02 0.001"/>

    <!-- 中路：7.6° 缓坡与 16.7° 陡坡，各有平台和对应下坡，起终点均接地。 -->
    <geom name="gentle_up" class="terrain" type="mesh" pos="1 0 0" mesh="ramp_gentle" rgba="0.42 0.56 0.65 1"/>
    <geom name="gentle_platform" class="terrain" type="box" pos="2.9 0 0.10" size="0.4 0.5 0.10" />
    <geom name="gentle_down" class="terrain" type="mesh" pos="4.8 0 0" mesh="ramp_gentle" euler="0 0 180" rgba="0.42 0.56 0.65 1"/>
    <geom name="steep_up" class="terrain" type="mesh" pos="5.2 0 0" mesh="ramp_steep" rgba="0.70 0.45 0.30 1"/>
    <geom name="steep_platform" class="terrain" type="box" pos="6.5 0 0.15" size="0.3 0.5 0.15" />
    <geom name="steep_down" class="terrain" type="mesh" pos="7.8 0 0" mesh="ramp_steep" euler="0 0 180" rgba="0.70 0.45 0.30 1"/>

    <!-- 左路：每级上升 2 cm，踏面长 0.35 m；最高 8 cm，然后逐级下降。 -->
    <geom name="stair_1" class="terrain" type="box" pos="1.175 2 0.010" size="0.175 0.5 0.010" rgba="0.550 0.50 0.32 1"/>
    <geom name="stair_2" class="terrain" type="box" pos="1.525 2 0.020" size="0.175 0.5 0.020" rgba="0.575 0.50 0.32 1"/>
    <geom name="stair_3" class="terrain" type="box" pos="1.875 2 0.030" size="0.175 0.5 0.030" rgba="0.600 0.50 0.32 1"/>
    <geom name="stair_4" class="terrain" type="box" pos="2.225 2 0.040" size="0.175 0.5 0.040" rgba="0.625 0.50 0.32 1"/>
    <geom name="stair_5" class="terrain" type="box" pos="2.575 2 0.030" size="0.175 0.5 0.030" rgba="0.650 0.50 0.32 1"/>
    <geom name="stair_6" class="terrain" type="box" pos="2.925 2 0.020" size="0.175 0.5 0.020" rgba="0.675 0.50 0.32 1"/>
    <geom name="stair_7" class="terrain" type="box" pos="3.275 2 0.010" size="0.175 0.5 0.010" rgba="0.700 0.50 0.32 1"/>

    <!-- 右路：左右轮交错越障，凸块顶面高度 1.5～5 cm，块间保留平地。 -->
    <geom name="offset_block_1" class="terrain" type="box" pos="1.200 -1.780 0.0075" size="0.12 0.20 0.0075" rgba="0.48 0.54 0.40 1"/>
    <geom name="offset_block_2" class="terrain" type="box" pos="1.650 -2.220 0.0100" size="0.12 0.20 0.0100" rgba="0.48 0.54 0.40 1"/>
    <geom name="offset_block_3" class="terrain" type="box" pos="2.100 -1.780 0.0125" size="0.12 0.20 0.0125" rgba="0.48 0.54 0.40 1"/>
    <geom name="offset_block_4" class="terrain" type="box" pos="2.550 -2.220 0.0150" size="0.12 0.20 0.0150" rgba="0.48 0.54 0.40 1"/>
    <geom name="offset_block_5" class="terrain" type="box" pos="3.000 -1.780 0.0175" size="0.12 0.20 0.0175" rgba="0.48 0.54 0.40 1"/>
    <geom name="offset_block_6" class="terrain" type="box" pos="3.450 -2.220 0.0200" size="0.12 0.20 0.0200" rgba="0.48 0.54 0.40 1"/>
    <geom name="offset_block_7" class="terrain" type="box" pos="3.900 -1.780 0.0225" size="0.12 0.20 0.0225" rgba="0.48 0.54 0.40 1"/>
    <geom name="offset_block_8" class="terrain" type="box" pos="4.350 -2.220 0.0250" size="0.12 0.20 0.0250" rgba="0.48 0.54 0.40 1"/>
    <geom name="offset_block_9" class="terrain" type="box" pos="4.800 -1.780 0.0275" size="0.12 0.20 0.0275" rgba="0.48 0.54 0.40 1"/>

    <!-- y=-4 沿 +X 行驶：圆弧减速带逐渐增高，随后通过宽 0.42 m 的低桥。 -->
    <geom name="round_bump_1" class="terrain" type="cylinder" pos="1.20 -4 0" size="0.010 0.5" euler="90 0 0" rgba="0.78 0.60 0.20 1"/>
    <geom name="round_bump_2" class="terrain" type="cylinder" pos="1.80 -4 0" size="0.020 0.5" euler="90 0 0" rgba="0.78 0.60 0.20 1"/>
    <geom name="round_bump_3" class="terrain" type="cylinder" pos="2.40 -4 0" size="0.030 0.5" euler="90 0 0" rgba="0.78 0.60 0.20 1"/>
    <geom name="round_bump_4" class="terrain" type="cylinder" pos="3.00 -4 0" size="0.040 0.5" euler="90 0 0" rgba="0.78 0.60 0.20 1"/>
    <geom name="bridge_entry" class="terrain" type="box" pos="3.900 -4 0.015074" size="0.301496 0.21 0.015" euler="0 -5.710593 0" rgba="0.45 0.53 0.62 1"/>
    <geom name="bridge_exit" class="terrain" type="box" pos="5.700 -4 0.015074" size="0.301496 0.21 0.015" euler="0 5.710593 0" rgba="0.45 0.53 0.62 1"/>
    <geom name="narrow_bridge" class="terrain" type="box" pos="4.8 -4 0.03" size="0.6 0.21 0.03" rgba="0.45 0.53 0.62 1"/>
  </worldbody>

</mujoco>
